<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="view_inherit_pos_config_kanban" model="ir.ui.view">
            <field name="name">view.inherit.pos.config.kanban</field>
            <field name="model">pos.config</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_config_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('o_kanban_primary_right')]" position="inside">
                    <div t-if="record.last_session_closing_date.value" invisible="not cash_control" class="row">
                        <div class="col-6">
                            <span>Current Session</span>
                        </div>
                        <div class="col-6">
                            <span>
                                <field name="current_session_net_sale" widget="monetary"/>
                            </span>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="view_inherit_pos_config_form" model="ir.ui.view">
            <field name="name">view.inherit.pos.config.form</field>
            <field name="model">pos.config</field>
            <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
            <field name="arch" type="xml">


                <xpath expr="//sheet/div[4]/div" position="before">
                    <setting id="session_balance" string="Session Balance"
                             help="Session Balance">
                        <field name="use_journal_ending_balance_as_opening"/>
                        <field name="opening_journal_id"
                               invisible="not use_journal_ending_balance_as_opening"
                               required="use_journal_ending_balance_as_opening"/>
                    </setting>
                    <setting id="closing_session_diff" string="Close Session With Diff"
                             help="Close Session With Difference">
                        <field name="accept_closing_session_diff"/>
                    </setting>
                </xpath>

            </field>
        </record>


    </data>
</odoo>